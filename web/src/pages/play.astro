---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { TOWERS, TOWER_ORDER, ENEMIES } from "../game/defs";

const tray = TOWER_ORDER.map((k) => {
  const t = TOWERS[k];
  const treats = Object.values(ENEMIES).filter((e) => e.counters.includes(k)).map((e) => e.name);
  return { ...t, treats };
});
---
<Base title="Defend the Circle" description="A tower-defense game about keeping an AI agent on task. Disorders swarm the meeting; place the right intervention on the right chair before the context window caves." current="/play">
  <section class="play-wrap">
    <div class="arena" id="arena">
      <canvas id="cv" aria-label="Defend the Circle game board" role="img"></canvas>

      <div class="hud" aria-live="polite">
        <div class="h-item"><span class="h-l mono">wave</span><b id="h-wave">0</b></div>
        <div class="h-item ctx"><span class="h-l mono">context</span><b id="h-ctx">100%</b><span class="bar"><i id="h-ctxbar"></i></span></div>
        <div class="h-item"><span class="h-l mono">coffee</span><b id="h-tok">150</b></div>
        <div class="h-item hide-s"><span class="h-l mono">score</span><b id="h-score">0</b></div>
        <div class="h-btns">
          <button class="icon" id="b-next" title="Call the next wave early (Space)">Next wave ▸</button>
          <button class="icon serene" id="b-serenity" title="The Serenity Prompt (S): freeze and unmask every disorder for 4s">☮ <span id="ser-cost">250</span></button>
          <button class="icon" id="b-pause" title="Pause (P)" aria-label="Pause">❚❚</button>
          <button class="icon" id="b-mute" title="Sound (M)" aria-label="Toggle sound">♪</button>
        </div>
      </div>

      <div class="pop" id="pop" hidden>
        <p class="pop-name" id="pop-name"></p>
        <p class="pop-lvl mono" id="pop-lvl"></p>
        <div class="pop-btns">
          <button class="btn clay" id="pop-up"></button>
          <button class="btn ghost" id="pop-sell"></button>
        </div>
      </div>

      <div class="banner" id="banner" hidden></div>

      <div class="coach" id="coach" hidden role="status">
        <span id="coach-text"></span>
        <button type="button" id="coach-x" aria-label="Hide tips">×</button>
      </div>

      <div class="overlay" id="ov-start">
        <div class="card start">
          <Mark size={46} />
          <p class="eyebrow">Agents Anonymous presents</p>
          <h1>Defend <em>the Circle</em></h1>
          <p class="sub">Bad habits are walking toward the agent's focus, the table in the middle. Stop them before they reach it.</p>
          <ul class="rules">
            <li><b>Pick a fix</b> from the tray, then <b>tap a chair</b> to place it. Fixes cost coffee ☕, which refills on its own.</li>
            <li>Each fix is <b>strong against one habit</b> and weak against the rest. Match them up.</li>
            <li>New habits come with a card that tells you what beats them.</li>
          </ul>
          <div class="start-btns">
            <button class="btn clay big" id="b-play">Take a seat <span class="arrow">→</span></button>
            <button class="btn ghost" id="b-daily">Tonight's meeting (daily)</button>
          </div>
          <p class="best mono" id="best"></p>
        </div>
      </div>

      <div class="overlay" id="ov-codex" hidden>
        <div class="card codex" id="codex"></div>
      </div>

      <div class="overlay" id="ov-pause" hidden>
        <div class="card">
          <h2>Paused</h2>
          <p class="sub">The coffee is still warm.</p>
          <button class="btn clay" id="b-resume">Resume</button>
        </div>
      </div>

      <div class="overlay" id="ov-over" hidden>
        <div class="card over" id="over"></div>
      </div>
    </div>

    <aside class="tray" aria-label="Interventions">
      <p class="tray-l mono">Fixes <span>· keys 1–7</span></p>
      <div class="tray-list" id="tray">
        {tray.map((t, i) => (
          <button class="tw" data-kind={t.kind} style={`--c:${t.color}`} aria-pressed="false">
            <span class="tw-g">{t.glyph}</span>
            <span class="tw-txt">
              <span class="tw-n">{t.name}</span>
              <span class="tw-t">treats {t.treats.join(", ")}</span>
            </span>
            <span class="tw-c mono">☕{t.cost}</span>
            <kbd class="tw-k">{i + 1}</kbd>
          </button>
        ))}
      </div>
      <p class="tray-foot">Stuck? ☮ <b>Serenity</b> freezes everything for 4 seconds. Each fix is a real habit from <a href="/steps">the 12 Steps</a>.</p>
    </aside>
  </section>
</Base>

<script>
  import { Game, draw, pick, CHAIRS, upgradeCost, sellValue, W, type View, type Overlay } from "../game/defend";
  import { TOWERS, TOWER_ORDER, ENEMIES, type TowerKind, type EnemyDef } from "../game/defs";
  import { play, unlock, isMuted, setMuted } from "../game/audio";

  const $ = (id: string) => document.getElementById(id)!;
  const cv = $("cv") as HTMLCanvasElement;
  const ctx = cv.getContext("2d", { alpha: false })!;
  const arena = $("arena");
  let view: View = { scale: 1, ox: 0, oy: 0, dpr: 1, w: 1, h: 1 };
  const ov: Overlay = { hoverChair: null, selectedKind: null, selectedChair: null };
  let game: Game;
  let paused = false;
  let daily = false;
  let codexOpen = false;
  let last = performance.now();

  const todaySeed = () => Number(new Date().toISOString().slice(0, 10).replaceAll("-", ""));
  const bestKey = () => (daily ? `aa:best:${todaySeed()}` : "aa:best");
  const getBest = () => {
    try { return JSON.parse(localStorage.getItem(bestKey()) || "null"); } catch { return null; }
  };

  function resize() {
    const r = arena.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = Math.round(r.width * dpr);
    cv.height = Math.round(r.height * dpr);
    cv.style.width = `${r.width}px`;
    cv.style.height = `${r.height}px`;
    const visible = r.width < 560 ? 600 : 700; // world units across the shorter side
    const hudPad = r.width < 560 ? 56 : 0;
    const scale = Math.min(r.width, r.height - hudPad) / visible;
    view = { scale, ox: r.width / 2 - (W / 2) * scale, oy: hudPad + (r.height - hudPad) / 2 - (W / 2) * scale, dpr, w: r.width, h: r.height };
  }
  new ResizeObserver(resize).observe(arena);

  function newGame(isDaily: boolean) {
    daily = isDaily;
    game = new Game(isDaily ? todaySeed() : Math.floor(Math.random() * 1e9), {
      onChange: hud,
      onNewEnemy: codex,
      onWave: banner,
      onOver: over,
      sound: play,
    });
    ov.selectedChair = null;
    ov.selectedKind = null;
    hidePop();
    paused = false;
    game.start();
    syncTray();
    hud();
  }

  // ───────────── HUD
  let lastHud = "";
  function hud() {
    if (!game) return;
    const s = `${game.wave}|${Math.floor(game.tokens)}|${game.context}|${game.score}|${game.state}|${Math.ceil(game.betweenT)}`;
    if (s === lastHud) return;
    lastHud = s;
    $("h-wave").textContent = String(game.wave);
    $("h-tok").textContent = String(Math.floor(game.tokens));
    $("h-ctx").textContent = `${game.context}%`;
    $("h-score").textContent = game.score.toLocaleString();
    ($("h-ctxbar") as HTMLElement).style.width = `${game.context}%`;
    ($("h-ctxbar") as HTMLElement).style.background = game.context > 50 ? "#c9f2dc" : game.context > 25 ? "#e9a25b" : "#e46a6a";
    const nb = $("b-next") as HTMLButtonElement;
    nb.hidden = game.state !== "between";
    $("ser-cost").textContent = String(game.serenityCost);
    ($("b-serenity") as HTMLButtonElement).disabled = game.state !== "running" || game.tokens < game.serenityCost;
    nb.textContent = game.wave === 0 ? "Start ▸" : `Next wave ▸ ${Math.max(0, Math.ceil(game.betweenT))}`;
    syncTray();
    if (ov.selectedChair !== null) showPop(ov.selectedChair);
    coach();
  }

  // ───────────── first-run coaching
  let coachOff = (() => { try { return localStorage.getItem("aa:coached") === "1"; } catch { return false; } })();
  let lastTip = "";
  function coach() {
    const el = $("coach");
    if (!game || coachOff || game.state === "over" || game.state === "ready") { el.hidden = true; return; }
    const narrow = matchMedia("(max-width: 1020px)").matches;
    const where = narrow ? "below" : "on the right";
    const towers = game.towers.size;
    const leakedKinds = Object.keys(game.leaked) as (keyof typeof ENEMIES)[];
    const missing = leakedKinds.find((k) => !ENEMIES[k].counters.some((c) => [...game.towers.values()].some((t) => t.kind === c)));
    let tip = "";
    if (game.wave === 0 && towers === 0) tip = ov.selectedKind ? "Now tap any empty chair around the table." : `Pick “Run the Tests” ${where}, then tap an empty chair.`;
    else if (game.wave === 0) tip = "Nice. Press Start when you're ready, or add another first.";
    else if (missing) {
      const d = ENEMIES[missing];
      tip = `${d.name} got through. ${d.counters.map((c) => TOWERS[c].name).join(" or ")} stops it.`;
    } else if (game.wave >= 2 && game.wave <= 3 && towers > 0) tip = "Tip: tap a chair you've already used to upgrade it.";
    else if (game.wave >= 4) {
      coachOff = true;
      try { localStorage.setItem("aa:coached", "1"); } catch {}
    }
    if (!tip) { el.hidden = true; return; }
    if (tip !== lastTip) {
      $("coach-text").textContent = tip;
      lastTip = tip;
      el.classList.remove("in");
      void el.offsetWidth;
      el.classList.add("in");
    }
    el.hidden = false;
  }

  function syncTray() {
    document.querySelectorAll<HTMLButtonElement>(".tw").forEach((b) => {
      const k = b.dataset.kind as TowerKind;
      b.classList.toggle("broke", !!game && game.tokens < TOWERS[k].cost);
      b.setAttribute("aria-pressed", String(ov.selectedKind === k));
    });
  }

  function banner(w: number) {
    const b = $("banner");
    b.innerHTML = `<span class="mono">wave</span> ${w}`;
    b.hidden = false;
    b.classList.remove("go");
    void b.offsetWidth;
    b.classList.add("go");
    setTimeout(() => (b.hidden = true), 1600);
  }

  function codex(def: EnemyDef) {
    if (!game || game.wave === 0) return;
    codexOpen = true;
    const treat = def.counters.map((k) => TOWERS[k]);
    $("codex").innerHTML = `
      <p class="eyebrow">New habit</p>
      <div class="cx-head"><span class="cx-g" style="--c:${def.color}">${def.glyph}</span><h2>${def.name}</h2></div>
      <p class="sub">${def.tip}</p>
      <p class="cx-treat mono">beat it with ${treat.map((t) => `<b style="color:${t.color}">${t.glyph} ${t.name}</b>`).join(" or ")}</p>
      <div class="start-btns"><button class="btn clay" id="cx-ok">Got it</button><a class="btn ghost" href="/manual/${def.kind}" target="_blank" rel="noopener">Manual entry ↗</a></div>`;
    $("ov-codex").hidden = false;
    $("cx-ok").addEventListener("click", closeCodex, { once: true });
  }
  function closeCodex() {
    codexOpen = false;
    $("ov-codex").hidden = true;
    last = performance.now();
  }

  function over() {
    const best = getBest();
    const run = { wave: game.wave, score: game.score, kills: game.kills };
    const isBest = !best || run.score > best.score;
    if (isBest) try { localStorage.setItem(bestKey(), JSON.stringify(run)); } catch {}
    const worst = Object.entries(game.leaked).sort((a, b) => (b[1] ?? 0) - (a[1] ?? 0))[0];
    const wdef = worst ? ENEMIES[worst[0] as keyof typeof ENEMIES] : null;
    const text = `I held the circle for ${game.wave} wave${game.wave === 1 ? "" : "s"} in Defend the Circle (${game.kills} disorders treated, score ${game.score.toLocaleString()}).${daily ? " Tonight's meeting." : ""}`;
    $("over").innerHTML = `
      <p class="eyebrow">The meeting is over</p>
      <h2>${game.wave >= 10 ? "You held the room." : game.wave >= 5 ? "A good night, mostly." : "Keep coming back."}</h2>
      <dl class="stats">
        <div><dt>waves</dt><dd>${game.wave}</dd></div>
        <div><dt>treated</dt><dd>${game.kills}</dd></div>
        <div><dt>score</dt><dd>${game.score.toLocaleString()}</dd></div>
      </dl>
      ${isBest ? `<p class="best-new hand">new personal best!</p>` : best ? `<p class="mono small">best: wave ${best.wave} · ${best.score.toLocaleString()}</p>` : ""}
      ${wdef ? `<p class="sub">What got through most: <b style="color:${wdef.color}">${wdef.name}</b>. Its treatment is <b>${wdef.counters.map((k) => TOWERS[k].name).join(" or ")}</b>. <a href="/manual/${wdef.kind}">Read the entry →</a></p>` : ""}
      <div class="start-btns">
        <button class="btn clay" id="b-again">Another meeting</button>
        <button class="btn ghost" id="b-share">Share</button>
      </div>`;
    $("ov-over").hidden = false;
    $("b-again").addEventListener("click", () => { $("ov-over").hidden = true; newGame(daily); });
    $("b-share").addEventListener("click", async () => {
      const url = "https://agents-anonymous.pages.dev/play";
      try {
        if (navigator.share) await navigator.share({ title: "Defend the Circle", text, url });
        else { await navigator.clipboard.writeText(`${text} ${url}`); $("b-share").textContent = "Copied"; }
      } catch {}
    });
  }

  // ───────────── tower popover
  function showPop(chair: number) {
    const t = game.towers.get(chair);
    if (!t) return hidePop();
    const def = TOWERS[t.kind];
    const ch = CHAIRS[chair];
    const pop = $("pop");
    $("pop-name").textContent = def.name;
    $("pop-name").style.color = def.color;
    $("pop-lvl").textContent = `level ${t.level} · ${def.blurb}`;
    const up = $("pop-up") as HTMLButtonElement;
    if (t.level >= 3) { up.textContent = "Max level"; up.disabled = true; }
    else { const c = upgradeCost(t); up.textContent = `Upgrade ☕${c}`; up.disabled = game.tokens < c; }
    $("pop-sell").textContent = `Sell ☕${sellValue(t)}`;
    pop.hidden = false;
    const px = ch.x * view.scale + view.ox;
    const py = ch.y * view.scale + view.oy;
    const pw = pop.offsetWidth, ph = pop.offsetHeight;
    const left = Math.min(Math.max(8, px - pw / 2), view.w - pw - 8);
    const top = py - ph - 34 * view.scale - 10 < 60 ? py + 34 * view.scale + 8 : py - ph - 34 * view.scale - 8;
    pop.style.transform = `translate(${left}px, ${Math.min(top, view.h - ph - 8)}px)`;
  }
  function hidePop() { $("pop").hidden = true; }
  $("pop-up").addEventListener("click", () => { if (ov.selectedChair !== null) game.upgrade(ov.selectedChair); });
  $("pop-sell").addEventListener("click", () => {
    if (ov.selectedChair !== null) game.sell(ov.selectedChair);
    ov.selectedChair = null;
    hidePop();
  });

  // ───────────── input
  function select(kind: TowerKind | null) {
    ov.selectedKind = ov.selectedKind === kind ? null : kind;
    ov.selectedChair = null;
    hidePop();
    syncTray();
    coach();
  }
  $("tray").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".tw");
    if (b) { unlock(); select(b.dataset.kind as TowerKind); }
  });

  const local = (e: PointerEvent) => {
    const r = cv.getBoundingClientRect();
    return pick(view, e.clientX - r.left, e.clientY - r.top);
  };
  cv.addEventListener("pointermove", (e) => {
    if (e.pointerType !== "mouse") return;
    ov.hoverChair = local(e).chair;
    cv.style.cursor = ov.hoverChair !== null && (ov.selectedKind || game?.towers.has(ov.hoverChair)) ? "pointer" : "default";
  });
  cv.addEventListener("pointerleave", () => (ov.hoverChair = null));
  cv.addEventListener("pointerdown", (e) => {
    if (!game || game.state === "over") return;
    unlock();
    const { chair } = local(e);
    if (chair === null) {
      ov.selectedChair = null;
      hidePop();
      return;
    }
    if (game.towers.has(chair)) {
      ov.selectedChair = ov.selectedChair === chair ? null : chair;
      ov.selectedChair === null ? hidePop() : showPop(chair);
      return;
    }
    if (ov.selectedKind) {
      if (game.place(chair, ov.selectedKind) && !game.canAfford(ov.selectedKind)) select(null);
    } else {
      // nudge: no intervention chosen yet
      document.querySelector(".tray")!.classList.remove("nudge");
      void (document.querySelector(".tray") as HTMLElement).offsetWidth;
      document.querySelector(".tray")!.classList.add("nudge");
    }
  });

  window.addEventListener("keydown", (e) => {
    if (!game || e.target instanceof HTMLInputElement) return;
    const n = Number(e.key);
    if (n >= 1 && n <= TOWER_ORDER.length) select(TOWER_ORDER[n - 1]);
    else if (e.key === "Escape") { select(null); if (codexOpen) closeCodex(); }
    else if (e.key === " ") { e.preventDefault(); if (codexOpen) closeCodex(); else if (game.state === "between") game.nextWave(); }
    else if (e.key.toLowerCase() === "p") togglePause();
    else if (e.key.toLowerCase() === "s") game.serenity();
    else if (e.key.toLowerCase() === "m") toggleMute();
    else if (e.key.toLowerCase() === "u" && ov.selectedChair !== null) game.upgrade(ov.selectedChair);
  });

  function togglePause() {
    if (!game || game.state === "over" || game.state === "ready") return;
    paused = !paused;
    $("ov-pause").hidden = !paused;
    last = performance.now();
  }
  function toggleMute() {
    setMuted(!isMuted());
    $("b-mute").classList.toggle("off", isMuted());
  }
  $("coach-x").addEventListener("click", () => {
    coachOff = true;
    try { localStorage.setItem("aa:coached", "1"); } catch {}
    $("coach").hidden = true;
  });
  $("b-pause").addEventListener("click", togglePause);
  $("b-serenity").addEventListener("click", () => game?.serenity());
  $("b-resume").addEventListener("click", togglePause);
  $("b-mute").addEventListener("click", () => { unlock(); toggleMute(); });
  $("b-mute").classList.toggle("off", isMuted());
  $("b-next").addEventListener("click", () => game?.nextWave());
  $("b-play").addEventListener("click", () => { unlock(); $("ov-start").hidden = true; newGame(false); });
  $("b-daily").addEventListener("click", () => { unlock(); $("ov-start").hidden = true; newGame(true); });
  document.addEventListener("visibilitychange", () => { if (document.hidden && game && !paused && game.state !== "over" && game.state !== "ready") togglePause(); });

  const best = getBest();
  if (best) $("best").textContent = `your best: wave ${best.wave} · ${best.score.toLocaleString()} points`;

  // attract mode behind the start screen
  game = new Game(7, {});
  for (const c of [0, 3, 6, 9]) game.towers.set(c, { chair: c, kind: TOWER_ORDER[c % 7], level: 1, cd: 1, flash: 0, aim: 0, spent: 0 });

  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    if (!paused && !codexOpen) game.tick(dt);
    else game.tick(0);
    draw(ctx, game, view, ov);
    if (game.state === "between") hud();
    requestAnimationFrame(frame);
  }
  // handle for automated tests and the curious
  (window as any).__aa = { get game() { return game; }, ov };
  resize();
  requestAnimationFrame(frame);
</script>

<style>
  :global(body:has(.play-wrap) > footer) { display: none; }
  .play-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    height: calc(100dvh - 65px);
    min-height: 520px;
    background: var(--night-0);
  }
  .arena { position: relative; overflow: hidden; touch-action: manipulation; user-select: none; -webkit-user-select: none; }
  canvas { position: absolute; inset: 0; display: block; }

  .hud { position: absolute; left: 12px; right: 12px; top: 12px; display: flex; gap: 8px; align-items: stretch; pointer-events: none; flex-wrap: wrap; z-index: 2; }
  .h-item { display: grid; gap: 3px; padding: 8px 12px; border-radius: 12px; background: #13100dcc; border: 1px solid var(--night-line); backdrop-filter: blur(8px); min-width: 64px; }
  .h-l { font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--chalk-3); }
  .h-item b { font: 400 1.35rem/1 var(--serif); font-variant-numeric: tabular-nums; }
  .ctx { min-width: 118px; }
  .bar { height: 4px; border-radius: 2px; background: #ffffff14; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 100%; transition: width 0.3s var(--ease), background 0.3s; }
  .h-btns { margin-left: auto; display: flex; gap: 6px; align-items: start; pointer-events: auto; }
  .icon { height: 40px; min-width: 40px; padding: 0 12px; border-radius: 12px; border: 1px solid var(--night-line-2); background: #13100dcc; color: var(--chalk); font: 600 0.82rem/1 var(--sans); cursor: pointer; backdrop-filter: blur(8px); }
  .icon:hover { border-color: var(--chalk-3); }
  .icon.off { color: var(--chalk-3); text-decoration: line-through; }
  #b-next { background: var(--amber); color: #1f1a15; border: 0; }
  .serene { color: #d3f7e0; border-color: #d3f7e055; }
  .serene:disabled { opacity: 0.4; cursor: not-allowed; }

  .coach {
    position: absolute; left: 50%; bottom: 16px; translate: -50% 0; z-index: 3;
    display: flex; align-items: center; gap: 10px; max-width: min(92%, 520px);
    padding: 10px 10px 10px 16px; border-radius: 999px;
    background: #f6f1e7; color: #1f1a15; font: 600 0.9rem/1.3 var(--sans);
    box-shadow: 0 16px 40px -16px #000;
  }
  .coach.in { animation: coach-in 0.45s var(--ease-spring) both; }
  @keyframes coach-in { from { opacity: 0; transform: translateY(10px); } }
  .coach button { flex: none; width: 28px; height: 28px; border-radius: 50%; border: 0; background: #1f1a1514; color: #1f1a15; font-size: 1rem; cursor: pointer; }
  .pop { position: absolute; left: 0; top: 0; z-index: 4; width: 230px; padding: 12px; border-radius: 14px; background: #1b1612f2; border: 1px solid var(--night-line-2); box-shadow: 0 20px 40px -20px #000; }
  .pop-name { margin: 0; font: 450 1.05rem/1.2 var(--serif); }
  .pop-lvl { margin: 4px 0 10px; font-size: 0.7rem; color: var(--chalk-3); line-height: 1.4; }
  .pop-btns { display: flex; gap: 6px; }
