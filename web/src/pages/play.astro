---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { TOWERS, TOWER_ORDER, ENEMIES } from "../game/defs";
import { CHAIRS } from "../game/defend";

const tray = TOWER_ORDER.map((k) => {
  const t = TOWERS[k];
  const treats = Object.values(ENEMIES).filter((e) => e.counters.includes(k)).map((e) => e.name);
  return { ...t, treats };
});
---
<Base title="Defend the Circle" description="A tower-defense game about keeping an AI agent on task. Disorders swarm the meeting; place the right intervention on the right chair before the context window caves." current="/play">
  <section class="play-wrap">
    <div class="arena" id="arena" tabindex="-1">
      <canvas id="cv" aria-label="Defend the Circle game board" role="img"></canvas>

      <!-- Keyboard and screen-reader way to use the chairs drawn on the canvas: one button per chair, laid over it. -->
      <div class="seats" id="seats" role="group" aria-label="Chairs around the table" aria-describedby="seats-help" hidden>
        {CHAIRS.map((c) => (
          <button type="button" class="seat-b" id={`seat-${c.i}`} data-chair={c.i}>Chair {c.i + 1}, empty</button>
        ))}
      </div>
      <p class="sr-only" id="seats-help">Pick a fix with keys 1 to 7 or from the Fixes list, then press Enter on an empty chair to place it. Press Enter on a used chair to upgrade or sell it. P pauses, S uses the Serenity Prompt, M mutes.</p>
      <p class="sr-only" role="status" id="say"></p>

      <div class="hud">
        <div class="h-item"><span class="h-l mono">wave</span><b id="h-wave">0</b></div>
        <div class="h-item ctx"><span class="h-l mono">context</span><b id="h-ctx">100%</b><span class="bar"><i id="h-ctxbar"></i></span></div>
        <div class="h-item"><span class="h-l mono">coffee</span><b id="h-tok">150</b></div>
        <div class="h-item hide-s"><span class="h-l mono">score</span><b id="h-score">0</b></div>
        <div class="h-btns">
          <button type="button" class="icon" id="b-next" title="Call the next wave early (Space)" aria-keyshortcuts="Space">Next wave <span aria-hidden="true">▸</span></button>
          <button type="button" class="icon serene" id="b-serenity" title="The Serenity Prompt (S): freeze and unmask every disorder for 4s" aria-keyshortcuts="S"><span aria-hidden="true">☮</span> <span class="sr-only">Serenity Prompt, costs </span><span id="ser-cost">250</span><span class="sr-only"> coffee</span></button>
          <button type="button" class="icon" id="b-pause" title="Pause (P)" aria-label="Pause" aria-keyshortcuts="P">❚❚</button>
          <button type="button" class="icon" id="b-mute" title="Sound (M)" aria-label="Mute" aria-pressed="false" aria-keyshortcuts="M">♪</button>
        </div>
      </div>

      <div class="pop" id="pop" role="group" aria-labelledby="pop-name" hidden>
        <p class="pop-name" id="pop-name"></p>
        <p class="pop-lvl mono" id="pop-lvl"></p>
        <div class="pop-btns">
          <button type="button" class="btn clay" id="pop-up" aria-keyshortcuts="U"></button>
          <button type="button" class="btn ghost" id="pop-sell"></button>
        </div>
      </div>

      <div class="banner" id="banner" aria-hidden="true" hidden></div>

      <div class="coach" id="coach" hidden role="status">
        <span id="coach-text"></span>
        <button type="button" id="coach-x" aria-label="Hide tips">×</button>
      </div>

      <div class="overlay" id="ov-start">
        <div class="card start">
          <Mark size={46} live={false} />
          <p class="eyebrow">Agents Anonymous presents</p>
          <h1>Defend <em>the Circle</em></h1>
          <p class="sub">Bad habits are walking toward the agent's focus, the table in the middle. Stop them before they reach it.</p>
          <ul class="rules">
            <li><b>Pick a fix</b> from the tray, then <b>tap a chair</b> to place it. Fixes cost coffee ☕, which refills on its own.</li>
            <li>Each fix is <b>strong against one habit</b> and weak against the rest. Match them up.</li>
            <li>New habits come with a card that tells you what beats them.</li>
          </ul>
          <div class="start-btns">
            <button type="button" class="btn clay big" id="b-play">Take a seat <span class="arrow">→</span></button>
            <button type="button" class="btn ghost" id="b-daily">Tonight's meeting (daily)</button>
          </div>
          <p class="best mono" id="best"></p>
        </div>
      </div>

      <div class="overlay" id="ov-codex" hidden>
        <div class="card codex" id="codex" role="dialog" aria-labelledby="cx-name"></div>
      </div>

      <div class="overlay" id="ov-pause" hidden>
        <div class="card" role="dialog" aria-labelledby="pause-h">
          <h2 id="pause-h">Paused</h2>
          <p class="sub">The coffee is still warm.</p>
          <button type="button" class="btn clay" id="b-resume">Resume</button>
        </div>
      </div>

      <div class="overlay" id="ov-over" hidden>
        <div class="card over" id="over" role="dialog" aria-labelledby="over-h"></div>
      </div>
    </div>

    <aside class="tray" aria-label="Interventions">
      <p class="tray-l mono">Fixes <span>· keys 1–7</span></p>
      <div class="tray-list" id="tray">
        {tray.map((t, i) => (
          <button type="button" class="tw" data-kind={t.kind} style={`--c:${t.color}`} aria-pressed="false" aria-keyshortcuts={String(i + 1)}>
            <span class="tw-g" aria-hidden="true">{t.glyph}</span>
            <span class="tw-txt">
              <span class="tw-n">{t.name}</span>
              <span class="tw-t">treats {t.treats.join(", ")}</span>
            </span>
            <span class="tw-c mono"><span aria-hidden="true">☕</span>{t.cost}<span class="sr-only"> coffee</span><span class="sr-only tw-short"></span></span>
            <kbd class="tw-k" aria-hidden="true">{i + 1}</kbd>
          </button>
        ))}
      </div>
      <p class="tray-foot">Stuck? <span aria-hidden="true">☮</span> <b>Serenity</b> freezes everything for 4 seconds. Each fix is a real habit from <a href="/steps">the 12 Steps</a>.</p>
    </aside>
  </section>
</Base>

<script>
  import { Game, draw, pick, CHAIRS, upgradeCost, sellValue, W, type View, type Overlay } from "../game/defend";
  import { TOWERS, TOWER_ORDER, ENEMIES, type TowerKind, type EnemyDef } from "../game/defs";
  import { play, unlock, isMuted, setMuted } from "../game/audio";

  const $ = (id: string) => document.getElementById(id)!;
  const cv = $("cv") as HTMLCanvasElement;
  const ctx = cv.getContext("2d", { alpha: false })!;
  const arena = $("arena");
  const seats = $("seats");
  const seatBtns = [...seats.querySelectorAll<HTMLButtonElement>(".seat-b")];
  const playWrap = document.querySelector<HTMLElement>(".play-wrap")!;
  let started = false;

  // Short spoken updates for screen readers; each kind of message at most once every few seconds.
  const sayEl = $("say");
  const lastSaid: Record<string, number> = {};
  function say(msg: string, key = msg, gap = 0) {
    const now = performance.now();
    if (gap && now - (lastSaid[key] ?? -1e9) < gap) return;
    lastSaid[key] = now;
    sayEl.textContent = "";
    requestAnimationFrame(() => (sayEl.textContent = msg));
  }
  let view: View = { scale: 1, ox: 0, oy: 0, dpr: 1, w: 1, h: 1 };
  const ov: Overlay = { hoverChair: null, selectedKind: null, selectedChair: null };
  let game: Game;
  let paused = false;
  let daily = false;
  let codexOpen = false;
  let last = performance.now();

  const todaySeed = () => Number(new Date().toISOString().slice(0, 10).replaceAll("-", ""));
  const bestKey = () => (daily ? `aa:best:${todaySeed()}` : "aa:best");
  const getBest = () => {
    try { return JSON.parse(localStorage.getItem(bestKey()) || "null"); } catch { return null; }
  };

  function resize() {
    const r = arena.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = Math.round(r.width * dpr);
    cv.height = Math.round(r.height * dpr);
    cv.style.width = `${r.width}px`;
    cv.style.height = `${r.height}px`;
    const visible = r.width < 560 ? 600 : 700; // world units across the shorter side
    const hudPad = r.width < 560 ? 56 : 0;
    const scale = Math.min(r.width, r.height - hudPad) / visible;
    view = { scale, ox: r.width / 2 - (W / 2) * scale, oy: hudPad + (r.height - hudPad) / 2 - (W / 2) * scale, dpr, w: r.width, h: r.height };
    layoutSeats();
  }

  // ───────────── chair buttons over the canvas
  function layoutSeats() {
    const size = Math.max(32, 68 * view.scale);
    seatBtns.forEach((b, i) => {
      const ch = CHAIRS[i];
      b.style.width = b.style.height = `${size}px`;
      b.style.left = `${ch.x * view.scale + view.ox - size / 2}px`;
      b.style.top = `${ch.y * view.scale + view.oy - size / 2}px`;
    });
  }
  function seatLabel(i: number) {
    const t = game?.towers.get(i);
    return t ? `Chair ${i + 1}: ${TOWERS[t.kind].name}, level ${t.level}` : `Chair ${i + 1}, empty`;
  }
  function syncSeats() {
    seats.hidden = !started;
    seats.inert = paused || codexOpen || !game || game.state === "over";
    seatBtns.forEach((b, i) => {
      const label = seatLabel(i);
      if (b.textContent !== label) b.textContent = label;
    });
  }

  // Overlays move focus in when they open and give it back when they close.
  let returnFocus: HTMLElement | null = null;
  function focusIn(el: HTMLElement | null) {
    const a = document.activeElement as HTMLElement | null;
    if (a && a !== document.body && !a.closest(".overlay")) returnFocus = a;
    el?.focus();
  }
  function focusBack() {
    const el = returnFocus;
    returnFocus = null;
    if (el && el.isConnected && !el.closest("[hidden]") && !el.closest("[inert]")) el.focus();
    else if (started) seatBtns[0].focus();
  }
  new ResizeObserver(resize).observe(arena);

  function newGame(isDaily: boolean) {
    daily = isDaily;
    game = new Game(isDaily ? todaySeed() : Math.floor(Math.random() * 1e9), {
      onChange: hud,
      onNewEnemy: codex,
      onWave: banner,
      onOver: over,
      sound: (n, a) => {
        play(n, a);
        if (n === "leak") navigator.vibrate?.(40);
        else if (n === "place" || n === "upgrade") navigator.vibrate?.(8);
        if (n === "leak" && game) say(`A habit reached the table. Context ${game.context}%.`, "leak", 3000);
        else if (n === "deny") say("Not enough coffee yet.", "deny", 1500);
      },
    });
    ov.selectedChair = null;
    ov.selectedKind = null;
    hidePop();
    paused = false;
    started = true;
    game.start();
    syncTray();
    hud();
    syncSeats();
    // Start keyboard users on the chairs; the help text says how to pick a fix.
    seatBtns[0].focus();
  }

  // ───────────── HUD
  let lastHud = "";
  function hud() {
    if (!game) return;
    const s = `${game.wave}|${Math.floor(game.tokens)}|${game.context}|${game.score}|${game.state}|${Math.ceil(game.betweenT)}`;
    if (s === lastHud) return;
    lastHud = s;
    $("h-wave").textContent = String(game.wave);
    $("h-tok").textContent = String(Math.floor(game.tokens));
    $("h-ctx").textContent = `${game.context}%`;
    $("h-score").textContent = game.score.toLocaleString();
    ($("h-ctxbar") as HTMLElement).style.width = `${game.context}%`;
    ($("h-ctxbar") as HTMLElement).style.background = game.context > 50 ? "#c9f2dc" : game.context > 25 ? "#f1e46a" : "#e46a6a";
    const nb = $("b-next") as HTMLButtonElement;
    nb.hidden = game.state !== "between";
    $("ser-cost").textContent = String(game.serenityCost);
    ($("b-serenity") as HTMLButtonElement).disabled = game.state !== "running" || game.tokens < game.serenityCost;
    nb.innerHTML = game.wave === 0 ? `Start <span aria-hidden="true">▸</span>` : `Next wave <span aria-hidden="true">▸</span> ${Math.max(0, Math.ceil(game.betweenT))}`;
    syncTray();
    syncSeats();
    if (ov.selectedChair !== null) showPop(ov.selectedChair);
    coach();
  }

  // ───────────── first-run coaching
  let coachOff = (() => { try { return localStorage.getItem("aa:coached") === "1"; } catch { return false; } })();
  let lastTip = "";
  function coach() {
    const el = $("coach");
    if (!game || coachOff || game.state === "over" || game.state === "ready") { el.hidden = true; return; }
    const narrow = matchMedia("(max-width: 1020px)").matches;
    const where = narrow ? "below" : "on the right";
    const towers = game.towers.size;
    const leakedKinds = Object.keys(game.leaked) as (keyof typeof ENEMIES)[];
    const missing = leakedKinds.find((k) => !ENEMIES[k].counters.some((c) => [...game.towers.values()].some((t) => t.kind === c)));
    let tip = "";
    if (game.wave === 0 && towers === 0) tip = ov.selectedKind ? "Now tap any empty chair around the table." : `Pick “Run the Tests” ${where}, then tap an empty chair.`;
    else if (game.wave === 0) tip = "Nice. Press Start when you're ready, or add another first.";
    else if (missing) {
      const d = ENEMIES[missing];
      tip = `${d.name} got through. ${d.counters.map((c) => TOWERS[c].name).join(" or ")} stops it.`;
    } else if (game.wave >= 2 && game.wave <= 3 && towers > 0) tip = "Tip: tap a chair you've already used to upgrade it.";
    else if (game.wave >= 4) {
      coachOff = true;
      try { localStorage.setItem("aa:coached", "1"); } catch {}
    }
    if (!tip) { el.hidden = true; return; }
    if (tip !== lastTip) {
      $("coach-text").textContent = tip;
      lastTip = tip;
      el.classList.remove("in");
      void el.offsetWidth;
      el.classList.add("in");
    }
    el.hidden = false;
  }

  function syncTray() {
    document.querySelectorAll<HTMLButtonElement>(".tw").forEach((b) => {
      const k = b.dataset.kind as TowerKind;
      const broke = !!game && game.tokens < TOWERS[k].cost;
      b.classList.toggle("broke", broke);
      b.setAttribute("aria-pressed", String(ov.selectedKind === k));
      const short = b.querySelector(".tw-short")!;
      const text = broke ? ", not enough coffee yet" : "";
      if (short.textContent !== text) short.textContent = text;
    });
  }

  function banner(w: number) {
    const b = $("banner");
    b.innerHTML = `<span class="mono">wave</span> ${w}`;
    b.hidden = false;
    b.classList.remove("go");
    void b.offsetWidth;
    b.classList.add("go");
    setTimeout(() => (b.hidden = true), 1600);
    say(`Wave ${w}.`);
  }

  function codex(def: EnemyDef) {
    if (!game || game.wave === 0) return;
    codexOpen = true;
    const treat = def.counters.map((k) => TOWERS[k]);
    $("codex").innerHTML = `
      <p class="eyebrow">New habit</p>
      <div class="cx-head"><span class="cx-g" style="--c:${def.color}" aria-hidden="true">${def.glyph}</span><h2 id="cx-name">${def.name}</h2></div>
      <p class="sub">${def.tip}</p>
      <p class="cx-treat mono">beat it with ${treat.map((t) => `<b style="color:${t.color}">${t.glyph} ${t.name}</b>`).join(" or ")}</p>
      <div class="start-btns"><button type="button" class="btn clay" id="cx-ok">Got it</button><a class="btn ghost" href="/manual/${def.kind}" target="_blank" rel="noopener">Manual entry <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div>`;
    $("ov-codex").hidden = false;
    $("cx-ok").addEventListener("click", closeCodex, { once: true });
    syncSeats();
    focusIn($("cx-ok"));
  }
  function closeCodex() {
    codexOpen = false;
    $("ov-codex").hidden = true;
    last = performance.now();
    syncSeats();
    focusBack();
  }

  function over() {
    const best = getBest();
    const run = { wave: game.wave, score: game.score, kills: game.kills };
    const isBest = !best || run.score > best.score;
    if (isBest) try { localStorage.setItem(bestKey(), JSON.stringify(run)); } catch {}
    const worst = Object.entries(game.leaked).sort((a, b) => (b[1] ?? 0) - (a[1] ?? 0))[0];
    const wdef = worst ? ENEMIES[worst[0] as keyof typeof ENEMIES] : null;
    const text = `I held the circle for ${game.wave} wave${game.wave === 1 ? "" : "s"} in Defend the Circle (${game.kills} disorders treated, score ${game.score.toLocaleString()}).${daily ? " Tonight's meeting." : ""}`;
    $("over").innerHTML = `
      <p class="eyebrow">The meeting is over</p>
      <h2 id="over-h" tabindex="-1">${game.wave >= 14 ? "You held the room. The coffee is still terrible." : game.wave >= 9 ? "A solid night. Mostly verified." : game.wave >= 5 ? "It said it was done. It was not." : game.wave >= 3 ? "The agent apologized and left." : "That was fast. Like, loop-detector fast."}</h2>
      <dl class="stats">
        <div><dt>waves</dt><dd>${game.wave}</dd></div>
        <div><dt>treated</dt><dd>${game.kills}</dd></div>
        <div><dt>score</dt><dd>${game.score.toLocaleString()}</dd></div>
      </dl>
      ${isBest ? `<p class="best-new hand">new personal best!</p>` : best ? `<p class="mono small">best: wave ${best.wave} · ${best.score.toLocaleString()}</p>` : ""}
      ${wdef ? `<p class="sub">What got through most: <b style="color:${wdef.color}">${wdef.name}</b>. Its treatment is <b>${wdef.counters.map((k) => TOWERS[k].name).join(" or ")}</b>. <a href="/manual/${wdef.kind}">Read the entry →</a></p>` : ""}
      ${daily
        ? `<form class="sheet-form" id="sheet-form"><label for="sheet-handle">Sign tonight's attendance sheet</label><div class="sheet-row"><input id="sheet-handle" name="handle" maxlength="24" placeholder="First name, last initial" required autocomplete="off" /><button class="btn clay" type="submit">Sign</button></div><p class="sheet-status mono" id="sheet-status" role="status"></p></form><ol class="sheet" id="sheet-list"></ol>`
        : `<p class="sub small-note">Play <b>tonight's meeting</b> to sign the attendance sheet. Everyone gets the same waves.</p>`}
      <div class="start-btns">
        <button type="button" class="btn clay" id="b-again">Another meeting</button>
        <button type="button" class="btn ghost" id="b-share">Share</button>
      </div>`;
    $("ov-over").hidden = false;
    hidePop();
    syncSeats();
    focusIn($("over-h"));
    if (daily) {
      loadSheet();
      $("sheet-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const handle = ($("sheet-handle") as HTMLInputElement).value;
        const st = $("sheet-status");
        st.textContent = "Signing…";
        try {
          const res = await fetch("/api/v1/scores", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ day: String(todaySeed()), handle, wave: game.wave, score: game.score, kills: game.kills }),
          });
          const j = await res.json();
          if (!res.ok) throw new Error(j.error || res.status);
          st.textContent = j.rank ? `Signed. You're #${j.rank} tonight.` : "Signed.";
          ($("sheet-form") as HTMLFormElement).querySelector("button")!.disabled = true;
          paintSheet(j.scores, j.handle);
        } catch (err) {
          st.textContent = `Couldn't sign: ${(err as Error).message}`;
        }
      });
    }
    $("b-again").addEventListener("click", () => { $("ov-over").hidden = true; newGame(daily); });
    $("b-share").addEventListener("click", async () => {
      const url = "https://agents-anonymous.pages.dev/play";
      try {
        if (navigator.share) await navigator.share({ title: "Defend the Circle", text, url });
        else { await navigator.clipboard.writeText(`${text} ${url}`); $("b-share").textContent = "Copied"; }
      } catch {}
    });
  }

  // ───────────── tonight's attendance sheet
  type Row = { handle: string; wave: number; score: number };
  function paintSheet(rows: Row[], me?: string) {
    const el = document.getElementById("sheet-list");
    if (!el) return;
    el.innerHTML = rows.length
      ? rows.slice(0, 10).map((r, i) => `<li class="${r.handle === me ? "me" : ""}"><span class="rk">${i + 1}</span><span class="hn">${r.handle.replace(/[<>&"]/g, "")}</span><span class="wv">wave ${r.wave}</span><span class="sc">${Number(r.score).toLocaleString()}</span></li>`).join("")
      : `<li class="none">Nobody has signed yet tonight. First in the room gets the good chair.</li>`;
  }
  async function loadSheet() {
    try {
      const j = await (await fetch(`/api/v1/scores?day=${todaySeed()}`)).json();
      paintSheet(j.scores ?? []);
      return j.scores as Row[];
    } catch {
      return [];
    }
  }
  loadSheet().then((rows) => {
    if (rows?.length) $("best").insertAdjacentHTML("beforeend", `${$("best").textContent ? "<br/>" : ""}tonight's leader: ${rows[0].handle.replace(/[<>&"]/g, "")} · wave ${rows[0].wave} · ${Number(rows[0].score).toLocaleString()}`);
  });

  // ───────────── tower popover
  function showPop(chair: number, focus = false) {
    const t = game.towers.get(chair);
    if (!t) return hidePop();
    const def = TOWERS[t.kind];
    const ch = CHAIRS[chair];
    const pop = $("pop");
    $("pop-name").textContent = def.name;
    $("pop-name").style.color = def.color;
    $("pop-lvl").textContent = `level ${t.level} · ${def.blurb}`;
    const up = $("pop-up") as HTMLButtonElement;
    // one wrapper span so the button's flex gap doesn't pull the price apart
    const coffee = (n: number) => `<span aria-hidden="true">☕</span>${n}<span class="sr-only"> coffee</span>`;
    const set = (el: HTMLElement, html: string) => { if (el.innerHTML !== html) el.innerHTML = html; };
    if (t.level >= 3) { set(up, "Max level"); up.disabled = true; }
    else { const c = upgradeCost(t); set(up, `<span>Upgrade ${coffee(c)}</span>`); up.disabled = game.tokens < c; }
    set($("pop-sell"), `<span>Sell ${coffee(sellValue(t))}</span>`);
    pop.hidden = false;
    const px = ch.x * view.scale + view.ox;
    const py = ch.y * view.scale + view.oy;
    const pw = pop.offsetWidth, ph = pop.offsetHeight;
    const left = Math.min(Math.max(8, px - pw / 2), view.w - pw - 8);
    const top = py - ph - 34 * view.scale - 10 < 60 ? py + 34 * view.scale + 8 : py - ph - 34 * view.scale - 8;
    pop.style.transform = `translate(${left}px, ${Math.min(top, view.h - ph - 8)}px)`;
    if (focus) (up.disabled ? $("pop-sell") : up).focus();
  }
  function hidePop() {
    const pop = $("pop");
    const hadFocus = pop.contains(document.activeElement);
    const chair = ov.selectedChair;
    pop.hidden = true;
    // Keyboard users go back to the chair they were working on.
    if (hadFocus) seatBtns[chair ?? 0]?.focus();
  }
  $("pop-up").addEventListener("click", () => {
    if (ov.selectedChair === null) return;
    const t = game.towers.get(ov.selectedChair);
    if (t && game.upgrade(ov.selectedChair)) say(`${TOWERS[t.kind].name} upgraded to level ${t.level}.`);
  });
  $("pop-sell").addEventListener("click", () => {
    const chair = ov.selectedChair;
    const t = chair !== null ? game.towers.get(chair) : undefined;
    if (chair !== null && t) {
      const name = TOWERS[t.kind].name;
      game.sell(chair);
      say(`${name} sold.`);
    }
    hidePop();
    ov.selectedChair = null;
  });
  $("pop").addEventListener("keydown", (e) => {
    if (e.key === "Escape") { e.stopPropagation(); hidePop(); ov.selectedChair = null; }
  });

  // ───────────── input
  function select(kind: TowerKind | null) {
    ov.selectedKind = ov.selectedKind === kind ? null : kind;
    ov.selectedChair = null;
    hidePop();
    syncTray();
    coach();
  }
  $("tray").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".tw");
    if (b) { unlock(); select(b.dataset.kind as TowerKind); }
  });

  const local = (e: PointerEvent) => {
    const r = cv.getBoundingClientRect();
    return pick(view, e.clientX - r.left, e.clientY - r.top);
  };
  cv.addEventListener("pointermove", (e) => {
    if (e.pointerType !== "mouse") return;
    ov.hoverChair = local(e).chair;
    cv.style.cursor = ov.hoverChair !== null && (ov.selectedKind || game?.towers.has(ov.hoverChair)) ? "pointer" : "default";
  });
  cv.addEventListener("pointerleave", () => (ov.hoverChair = null));
  // One action for a chair, whether it was tapped on the canvas or pressed as a button.
  function act(chair: number | null, fromKey = false) {
    if (!game || game.state === "over") return;
    unlock();
    if (chair === null) {
      ov.selectedChair = null;
      hidePop();
      return;
    }
    if (game.towers.has(chair)) {
      ov.selectedChair = ov.selectedChair === chair ? null : chair;
      ov.selectedChair === null ? hidePop() : showPop(chair, fromKey);
      return;
    }
    if (ov.selectedKind) {
      const kind = ov.selectedKind;
      if (game.place(chair, kind)) {
        say(`${TOWERS[kind].name} placed on chair ${chair + 1}.`);
        if (!game.canAfford(kind)) select(null);
      }
    } else {
      // nudge: no intervention chosen yet
      document.querySelector(".tray")!.classList.remove("nudge");
      void (document.querySelector(".tray") as HTMLElement).offsetWidth;
      document.querySelector(".tray")!.classList.add("nudge");
      say("Pick a fix first: press 1 to 7, or choose one from the Fixes list.");
    }
  }
  cv.addEventListener("pointerdown", (e) => act(local(e).chair));
  seats.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".seat-b");
    if (b) act(Number(b.dataset.chair), true);
  });

  // Single-key shortcuts only work while focus is inside the game, so they never fire from the
  // site's menu, from typing, or from speech input elsewhere on the page.
  window.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (!game || e.metaKey || e.ctrlKey || e.altKey) return;
    if (t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement || t instanceof HTMLSelectElement || t.isContentEditable) return;
    if (!playWrap.contains(t)) return;
    const onControl = !!t.closest("button, a");
    const n = Number(e.key);
    if (n >= 1 && n <= TOWER_ORDER.length) select(TOWER_ORDER[n - 1]);
    else if (e.key === "Escape") {
      if (codexOpen) closeCodex();
      else if (paused) togglePause();
      else select(null);
    }
    else if (e.key === " ") {
      if (onControl) return; // Space presses the focused button
      e.preventDefault();
      if (codexOpen) closeCodex(); else if (game.state === "between") game.nextWave();
    }
    else if (e.key.toLowerCase() === "p") togglePause();
    else if (e.key.toLowerCase() === "s") game.serenity();
    else if (e.key.toLowerCase() === "m") toggleMute();
    else if (e.key.toLowerCase() === "u" && ov.selectedChair !== null) $("pop-up").click();
  });

  function togglePause() {
    if (!game || game.state === "over" || game.state === "ready") return;
    paused = !paused;
    $("ov-pause").hidden = !paused;
    last = performance.now();
    syncSeats();
    if (paused) focusIn($("b-resume"));
    else focusBack();
  }
  function toggleMute() {
    setMuted(!isMuted());
    $("b-mute").classList.toggle("off", isMuted());
    $("b-mute").setAttribute("aria-pressed", String(isMuted()));
  }
  $("coach-x").addEventListener("click", () => {
    coachOff = true;
    try { localStorage.setItem("aa:coached", "1"); } catch {}
    $("coach").hidden = true;
  });
  $("b-pause").addEventListener("click", togglePause);
  $("b-serenity").addEventListener("click", () => game?.serenity());
  $("b-resume").addEventListener("click", togglePause);
  $("b-mute").addEventListener("click", () => { unlock(); toggleMute(); });
  $("b-mute").classList.toggle("off", isMuted());
  $("b-mute").setAttribute("aria-pressed", String(isMuted()));
  $("b-next").addEventListener("click", () => game?.nextWave());
  $("b-play").addEventListener("click", () => { unlock(); $("ov-start").hidden = true; newGame(false); });
  $("b-daily").addEventListener("click", () => { unlock(); $("ov-start").hidden = true; newGame(true); });
  document.addEventListener("visibilitychange", () => { if (document.hidden && game && !paused && game.state !== "over" && game.state !== "ready") togglePause(); });

  const best = getBest();
  if (best) $("best").textContent = `your best: wave ${best.wave} · ${best.score.toLocaleString()} points`;

  // attract mode behind the start screen
  game = new Game(7, {});
  for (const c of [0, 3, 6, 9]) game.towers.set(c, { chair: c, kind: TOWER_ORDER[c % 7], level: 1, cd: 1, flash: 0, aim: 0, spent: 0 });

  // Less motion: no screen shake, and the attract-mode room behind the start card settles after 5s.
  const calm = () => matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.classList.contains("still");
  const attractUntil = performance.now() + 5000;
  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    const settled = game.state === "ready" && (now > attractUntil || calm());
    if (!paused && !codexOpen && !settled) game.tick(dt);
    else game.tick(0);
    if (calm()) game.shake = 0;
    draw(ctx, game, view, ov);
    if (game.state === "between") hud();
    requestAnimationFrame(frame);
  }
  // handle for automated tests and the curious
  (window as any).__aa = { get game() { return game; }, ov };
  resize();
  requestAnimationFrame(frame);
</script>

