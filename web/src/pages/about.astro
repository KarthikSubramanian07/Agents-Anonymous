---
import Base from "../layouts/Base.astro";
import { faq } from "../lib/content";

const jsonld = { "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<Base title="About & FAQ" mood="day" description="What Agents Anonymous is, how it checks agent transcripts, how private it is, and how accurate it is." jsonld={jsonld}>
  <article class="wrap page">
    <p class="eyebrow">About</p>
    <h1>A joke you can <em>take seriously.</em></h1>
    <p class="lede">Agents Anonymous started from a simple observation: AI agents fail in a handful of very recognizable ways, and naming them makes them easier to fix.</p>
    <dl class="faq">
      {faq.map((f) => (
        <div><dt>{f.q}</dt><dd>{f.a}</dd></div>
      ))}
    </dl>
    <p class="made">Made by <a href="https://github.com/KarthikSubramanian07">Karthik Subramanian</a>. Source on <a href="https://github.com/KarthikSubramanian07/Agents-Anonymous">GitHub</a>.</p>
  </article>
</Base>
<style>
  .page { max-width: 820px; padding-block: clamp(40px, 7vw, 100px) clamp(70px, 9vw, 120px); }
  h1 { margin: 16px 0 18px; font-size: clamp(2.2rem, 1.5rem + 3vw, 4rem); }
  h1 em { color: var(--clay-deep); }
  .faq { margin: 40px 0 0; display: grid; }
  .faq div { padding: 22px 0; border-top: 1px solid var(--rule); }
  .faq dt { font: 450 var(--step-1)/1.3 var(--serif); margin-bottom: 8px; }
  .faq dd { margin: 0; color: var(--ink-2); max-width: 64ch; }
  .made { margin-top: 30px; color: var(--ink-3); font-size: 0.9rem; }
</style>
