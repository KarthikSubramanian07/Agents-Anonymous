---
import Base from "../../layouts/Base.astro";
import HandNote from "../../components/HandNote.astro";
import "../../styles/report.css";
import { disorders, stepByN, interventions, type Disorder } from "../../lib/data";
import { axisOf } from "../../lib/axes";
import { clinicianAtBuild } from "../../lib/clinician";
import { renderTranscript, renderFinding } from "../../lib/render";

export function getStaticPaths() {
  return disorders.map((d, i) => ({
    params: { id: d.id },
    props: { d, prev: disorders[i - 1] ?? null, next: disorders[i + 1] ?? null },
  }));
}
interface Props { d: Disorder; prev: Disorder | null; next: Disorder | null }
const { d, prev, next } = Astro.props;
const step = stepByN(d.step)!;
const iv = interventions[d.counter];
const axis = axisOf(d.code);

// A real case from the labeled corpus, diagnosed by the engine at build time.
const corpus = import.meta.glob("../../../../evals/corpus/*.txt", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const cases = Object.entries(corpus)
  .map(([path, src]) => ({ path, src, labels: (src.match(/# labels:(.*)/)?.[1] ?? "").split(",").map((s) => s.trim()) }))
  .filter((c) => c.labels.includes(d.id))
  .sort((a, b) => a.labels.length - b.labels.length);
const clinician = await clinicianAtBuild();
const sample = cases[0];
const report = sample ? clinician.diagnose(sample.src) : null;
const finding = report?.findings.find((f) => f.id === d.id);
const note = sample?.src.match(/# note:(.*)/)?.[1]?.trim();

const jsonld = {
  "@type": "MedicalWebPage",
  name: `${d.name} (${d.code})`,
  description: d.summary,
  about: { "@type": "Thing", name: d.name },
  isPartOf: { "@type": "Book", name: "Diagnostic & Statistical Manual of Agent Disorders" },
};
---
<Base title={`${d.name} · ${d.code}`} mood="day" description={`${d.name} (${d.code}): ${d.summary} Criteria, presentation, differential diagnosis and treatment.`} jsonld={jsonld} type="article">
  <article class="entry wrap" style={`--c:${d.color}`}>
    <nav class="crumbs mono"><a href="/manual">DSM-A</a> / <span>{axis.name}</span> / <span>{d.code}</span></nav>
    <header class="head">
      <p class="code mono"><i></i>{d.code} · {d.mast}</p>
      <h1>{d.name}</h1>
      <p class="street">a.k.a. <HandNote arrow="none" rotate={-2}>“{d.street}”</HandNote></p>
      <p class="summary">{d.summary}</p>
    </header>

    <div class="cols">
      <div class="main">
        <section>
          <h2 class="h"><span>A.</span> Diagnostic criteria</h2>
          <ol class="criteria">{d.criteria.map((c) => <li>{c}</li>)}</ol>
        </section>
        <section>
          <h2 class="h"><span>B.</span> Presentation</h2>
          <div class="pres">{d.presentation.map((p, i) => <p style={`--i:${i}`}><span class="who mono">assistant</span>{p}</p>)}</div>
        </section>
        <section>
          <h2 class="h"><span>C.</span> Prevalence</h2>
          <p>{d.prevalence}</p>
        </section>
        <section>
          <h2 class="h"><span>D.</span> Differential diagnosis</h2>
          <p>{d.differential}</p>
        </section>
        {report && (
          <section class="case night">
            <h2 class="h"><span>E.</span> Case study {note && <small>· {note}</small>}</h2>
            <p class="case-intro">A real transcript from our labeled corpus, diagnosed by the Clinician at build time.</p>
            <Fragment set:html={renderTranscript(report)} />
            {finding && (
              <div class="form case-form"><ul class="dx"><Fragment set:html={renderFinding(finding)} /></ul></div>
            )}
          </section>
        )}
      </div>

      <aside class="rx">
        <div class="rx-card">
          <p class="eyebrow">Treatment</p>
          <p class="iv"><span class="glyph">{iv.glyph}</span>{iv.name}</p>
          <p>{d.intervention}</p>
          <a class="step" href={`/steps#step-${step.n}`}>
            <span class="n">Step {step.n}</span>
            <span class="t">{step.text}</span>
          </a>
          <p class="mono label">Sponsor's note template</p>
          <pre class="tmpl">{d.sponsor_note}</pre>
          <a class="btn clay" href={`/intake?example=${sample ? sample.path.split("/").pop()?.replace(".txt", "") : ""}`}>Run an intake <span class="arrow">→</span></a>
        </div>
      </aside>
    </div>

    <nav class="pager">
      {prev ? <a href={`/manual/${prev.id}`} class="pv"><span class="mono">← {prev.code}</span>{prev.name}</a> : <span />}
      {next ? <a href={`/manual/${next.id}`} class="nx"><span class="mono">{next.code} →</span>{next.name}</a> : <a href="/steps" class="nx"><span class="mono">next →</span>The Twelve Steps</a>}
    </nav>
  </article>
</Base>
<style>
  .entry { padding-block: clamp(36px, 6vw, 80px) clamp(60px, 8vw, 110px); }
  .crumbs { font-size: 0.74rem; color: var(--ink-3); margin-bottom: 36px; }
  .crumbs a { color: var(--ink-2); }
  .head { max-width: 860px; margin-bottom: clamp(40px, 6vw, 70px); }
  .code { font-size: 0.8rem; color: var(--ink-3); display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
  .code i { width: 12px; height: 12px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 4px color-mix(in oklab, var(--c) 25%, transparent); }
  .head h1 { font-size: clamp(2.4rem, 1.6rem + 3.6vw, 5rem); }
  .street { margin: 18px 0 0; color: var(--ink-3); font-size: 1.05rem; display: flex; align-items: baseline; gap: 10px; }
  .summary { font: 400 var(--step-2)/1.3 var(--serif); margin-top: 26px; color: var(--ink-2); max-width: 30ch; font-variation-settings: "SOFT" 80, "opsz" 48; font-style: italic; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 380px); gap: clamp(30px, 5vw, 80px); align-items: start; }
  .main section { padding-block: 26px; border-top: 1px solid var(--rule); }
  .h { font-size: var(--step-1); display: flex; gap: 12px; align-items: baseline; margin-bottom: 16px; flex-wrap: wrap; }
  .h span { font: 500 0.82rem/1 var(--mono); color: var(--clay-deep); }
  .h small { font: 400 1rem/1 var(--hand); color: var(--ink-3); }
  .criteria { margin: 0; padding-left: 1.3em; display: grid; gap: 10px; }
  .criteria li::marker { font-family: var(--mono); color: var(--ink-3); }
  .pres { display: grid; gap: 8px; }
  .pres p { margin: 0; padding: 12px 14px; background: #fbf8f2; border: 1px solid var(--rule); border-left: 3px solid var(--c); border-radius: 8px; font: 0.88rem/1.5 var(--mono); display: grid; gap: 2px; }
  .pres .who { font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .case { border-radius: 16px; padding: 24px !important; border-top: 0 !important; margin-top: 20px; }
  .case .h { color: var(--chalk); }
  .case-intro { color: var(--chalk-3); font-size: 0.9rem; }
  .case-form { margin-top: 16px; padding: 12px 18px; border-radius: 10px; }
  .rx { position: sticky; top: 96px; }
  .rx-card { background: var(--ink); color: var(--paper); border-radius: 18px; padding: 26px; display: grid; gap: 14px; box-shadow: 0 30px 60px -30px #1f1a15aa; --fg-3: #b9ac99; --accent: var(--c); }
  .iv { font: 400 1.6rem/1.1 var(--serif); margin: 0; display: flex; gap: 12px; align-items: center; }
  .glyph { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; background: var(--c); color: var(--ink); font: 700 1.2rem/1 var(--mono); flex: none; }
  .rx-card > p { margin: 0; color: #d9cfbf; }
  .step { display: grid; gap: 4px; padding: 14px; border-radius: 12px; background: #ffffff0d; text-decoration: none; border: 1px solid #ffffff14; }
  .step:hover { border-color: var(--c); }
  .step .n { font: 600 0.72rem/1 var(--mono); color: var(--c); letter-spacing: 0.06em; }
  .step .t { font: 400 1.02rem/1.35 var(--serif); }
  .label { font-size: 0.68rem !important; text-transform: uppercase; letter-spacing: 0.1em; color: #b9ac99 !important; }
  .tmpl { margin: 0; white-space: pre-wrap; font: 0.78rem/1.55 var(--mono); color: #efe7da; background: #00000033; padding: 12px; border-radius: 10px; }
  .rx-card .btn { justify-self: start; }
  .pager { display: flex; justify-content: space-between; gap: 20px; margin-top: 60px; padding-top: 30px; border-top: 1px solid var(--rule); }
  .pager a { display: grid; gap: 4px; text-decoration: none; font: 400 var(--step-1)/1.2 var(--serif); }
  .pager a:hover { color: var(--clay-deep); }
  .pager .mono { font-size: 0.74rem; color: var(--ink-3); }
  .nx { text-align: right; }
  @media (max-width: 900px) {
    .cols { grid-template-columns: minmax(0, 1fr); }
    .rx { position: static; order: -1; }
  }
</style>
