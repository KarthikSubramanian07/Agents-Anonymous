---
import Base from "../../layouts/Base.astro";
import { disorders, manual } from "../../lib/data";
import { axes } from "../../lib/axes";
---
<Base title="The Manual (DSM-A)" mood="day" description="The Diagnostic & Statistical Manual of Agent Disorders, 1st Edition. Eleven failure patterns of AI agents, with criteria, differential diagnosis and treatment.">
  <section class="wrap manual">
    <div class="cover" aria-hidden="true">
      <div class="book">
        <span class="spine"></span>
        <span class="b-top">{manual.edition}</span>
        <span class="b-title">Diagnostic &amp; Statistical Manual of <em>Agent Disorders</em></span>
        <span class="b-mark">DSM-A</span>
        <span class="b-foot">Agents Anonymous Press · Basement Edition</span>
      </div>
    </div>
    <div class="toc">
      <p class="eyebrow">The Manual</p>
      <h1>The <em>DSM-A</em></h1>
      <p class="lede">
        A field guide to the 11 ways AI agents go wrong. Each entry covers how to spot it, what it isn't, and how
        to fix it. Most are based on <a href="https://arxiv.org/abs/2503.13657" rel="noopener">published research</a> on why agents fail.
      </p>
      {axes.map((ax) => (
        <section class="axis">
          <header><span class="mono">{ax.range}s</span><h2>{ax.name}</h2><p>{ax.blurb}</p></header>
          <ol>
            {disorders.filter((d) => d.code.slice(2, 3) === ax.range[0]).map((d) => (
              <li style={`--c:${d.color}`}>
                <a href={`/manual/${d.id}`}>
                  <span class="code">{d.code}</span>
                  <span class="nm">{d.short}<small>{d.name}</small></span>
                  <span class="dots" aria-hidden="true"></span>
                  <span class="st">“{d.street}”</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</Base>
<style>
  .manual { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(30px, 6vw, 100px); padding-block: clamp(50px, 8vw, 110px); align-items: start; }
  .cover { position: sticky; top: 110px; display: grid; justify-items: center; gap: 30px; }
  .book {
    position: relative; width: min(100%, 360px); aspect-ratio: 3 / 4.2; border-radius: 4px 12px 12px 4px; padding: 34px 30px 30px 44px;
    background: radial-gradient(120% 90% at 30% 20%, #2f4a43, #1d302b 70%), #1d302b;
    color: #e9dcc2; display: grid; grid-template-rows: auto 1fr auto auto; gap: 12px;
    box-shadow: inset 6px 0 10px -6px #0008, inset -2px 0 0 #ffffff12, 0 40px 60px -30px #131915cc, 0 2px 0 #0002;
    transform: perspective(900px) rotateY(-12deg) rotateX(3deg); transition: transform 0.8s var(--ease);
  }
  .book:hover { transform: perspective(900px) rotateY(-4deg); }
  .book::after { content: ""; position: absolute; right: 16%; bottom: 14%; width: 38%; aspect-ratio: 1; border-radius: 50%; border: 7px solid #6b4a2a33; filter: blur(0.6px); }
  .spine { position: absolute; left: 0; top: 0; bottom: 0; width: 22px; background: linear-gradient(90deg, #0004, #ffffff10 60%, #0003); border-radius: 4px 0 0 4px; }
  .b-top { font: 500 0.66rem/1 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; color: #cdb98f; border-bottom: 1px solid #cdb98f55; padding-bottom: 12px; }
  .b-title { font: 400 1.65rem/1.08 var(--serif); align-self: center; font-variation-settings: "SOFT" 100, "opsz" 72; }
  .b-title em { display: block; color: #f0c79a; }
  .b-mark { font: 300 3.2rem/1 var(--serif); letter-spacing: -0.03em; color: #cdb98f; }
  .b-foot { font: 0.64rem/1 var(--mono); color: #cdb98fbb; letter-spacing: 0.06em; }
  .toc h1 { margin: 18px 0 18px; }
  .toc h1 em { color: var(--clay-deep); }
  .toc .lede { max-width: 56ch; margin-bottom: 40px; }
  .axis { padding-block: 26px; border-top: 1px solid var(--rule); }
  .axis header { display: grid; grid-template-columns: 60px 1fr; column-gap: 12px; margin-bottom: 12px; }
  .axis header .mono { font-size: 0.78rem; color: var(--ink-3); padding-top: 8px; grid-row: span 2; }
  .axis h2 { font-size: var(--step-2); }
  .axis header p { color: var(--ink-3); margin: 6px 0 0; font-size: 0.95rem; }
  .axis ol { list-style: none; padding: 0 0 0 72px; margin: 0; }
  .axis li a { display: flex; align-items: baseline; gap: 10px; padding: 11px 0; text-decoration: none; border-bottom: 1px dashed #13191522; }
  .axis li a:hover .nm { color: var(--clay-deep); }
  .code { font: 500 0.76rem/1 var(--mono); color: var(--ink-3); flex: none; width: 86px; white-space: nowrap; }
  .code::before { content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--c); margin-right: 7px; }
  .nm { font: 450 1.12rem/1.3 var(--serif); transition: color 0.2s; display: grid; }
  .nm small { font: 0.76rem/1.3 var(--sans); color: var(--ink-3); }
  .dots { flex: 1; border-bottom: 1px dotted #13191540; translate: 0 -4px; min-width: 20px; }
  .st { font: 400 1.05rem/1 var(--hand); color: var(--ink-2); white-space: nowrap; }
  @media (max-width: 900px) {
    .manual { grid-template-columns: minmax(0, 1fr); }
    .cover { position: static; }
    .book { width: min(76%, 300px); }
    .axis ol { padding-left: 0; }
    .st, .dots { display: none; }
  }
</style>
