---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { graph } from "../lib/seo";
import { staticMarkdown } from "../lib/markdown";
import { mdPathFor, pageKey } from "../lib/negotiate";

interface Props {
  title?: string;
  description?: string;
  mood?: "night" | "day";
  current?: string;
  image?: string;
  type?: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
  keywords?: string;
}
const {
  title,
  description = "A support group for AI agents that loop, hallucinate, apologize too much and give up early. See where your agent went wrong and what to tell it next.",
  mood = "night",
  current = Astro.url.pathname,
  image = "/og/default.png",
  type = "website",
  jsonld,
  noindex = false,
  keywords,
} = Astro.props;
const site = Astro.site ?? new URL("https://agents-anonymous.pages.dev");
const fullTitle = title ? `${title} · Agents Anonymous` : "Agents Anonymous: diagnose AI agent failures · a support group for agents";
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const ld = graph(jsonld);
const mdTwins = new Set(Object.keys(staticMarkdown()));
const pagePath = pageKey(Astro.url.pathname);
const mdTwin = mdTwins.has(pagePath) ? mdPathFor(pagePath) : null;
---
<!doctype html>
<html lang="en" class={mood}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={mood === "day" ? "#eef0e8" : "#0e1311"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Agents Anonymous" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {mdTwin && <link rel="alternate" type="text/markdown" href={mdTwin} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <slot name="head" />
    <script is:inline>
      // Start with animations paused if the visitor paused them before, or asks their OS for less motion.
      try {
        var m = localStorage.getItem("aa:motion");
        if (m === "off" || (m === null && matchMedia("(prefers-reduced-motion: reduce)").matches)) document.documentElement.classList.add("still");
      } catch (e) {}
    </script>
  </head>
  <body class={mood}>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      // Reveal-on-scroll: tiny, no library.
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))),
        { rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      // One-tap copy on every code block.
      document.querySelectorAll<HTMLPreElement>("pre:has(> code)").forEach((pre) => {
        const box = document.createElement("div");
        box.className = "copybox";
        pre.replaceWith(box);
        box.append(pre);
        const b = document.createElement("button");
        b.type = "button";
        b.className = "copy-code";
        b.textContent = "Copy";
        b.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText.trim());
            b.textContent = "Copied (verified)";
          } catch {
            b.textContent = "Select & copy";
          }
          setTimeout(() => (b.textContent = "Copy"), 1600);
        });
        box.append(b);
      });
    </script>
  </body>
</html>
