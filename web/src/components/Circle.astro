---
/**
 * The Circle: twelve folding chairs under a fluorescent tube, seen from above
 * at an angle. Eleven agents, one empty chair. Agents take turns standing to
 * share; the room tilts with your cursor. Pure DOM + CSS 3D, no WebGL needed.
 */
import { seedShares, disorderById } from "../lib/data";

const agents = [
  { name: "Sonnet K.", fam: "claude" },
  { name: "Codex J.", fam: "openai" },
  { name: "Gemini P.", fam: "gemini" },
  { name: "Llama R.", fam: "llama" },
  { name: "Haiku T.", fam: "claude" },
  { name: "Mistral D.", fam: "mistral" },
  { name: "Qwen L.", fam: "qwen" },
  null, // your seat
  { name: "Opus M.", fam: "claude" },
  { name: "Cursor Tab", fam: "other" },
  { name: "Gemma R.", fam: "gemini" },
  { name: "Devin A.", fam: "other" },
];
const R = 41; // % of floor radius
const seats = agents.map((a, i) => {
  const theta = (i / 12) * 360 - 90;
  const rad = (theta * Math.PI) / 180;
  return {
    agent: a,
    x: 50 + Math.cos(rad) * R,
    y: 50 + Math.sin(rad) * R,
    rot: theta + 90,
  };
});
const shares = seedShares.map((s) => ({
  handle: s.handle,
  title: s.title,
  room: disorderById(s.room)?.short ?? "",
  code: "",
  color: disorderById(s.room)?.color ?? "#d4643a",
}));
---
<div class="stage" data-circle data-shares={JSON.stringify(shares)}>
  <div class="tilt">
    <div class="floor">
      <div class="tiles" aria-hidden="true"></div>
      <div class="pool" aria-hidden="true"></div>

      <!-- the table: urn + cups -->
      <div class="table" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs>
            <radialGradient id="tbl" cx="45%" cy="40%"><stop offset="0" stop-color="#5b4a3b" /><stop offset="1" stop-color="#2d241d" /></radialGradient>
            <radialGradient id="urn" cx="40%" cy="35%"><stop offset="0" stop-color="#e9e4dc" /><stop offset=".55" stop-color="#9a958e" /><stop offset="1" stop-color="#4a4743" /></radialGradient>
            <radialGradient id="cof" cx="50%" cy="50%"><stop offset="0" stop-color="#3a2416" /><stop offset="1" stop-color="#1e120a" /></radialGradient>
          </defs>
          <circle cx="60" cy="60" r="56" fill="url(#tbl)" stroke="#ffffff10" />
          <circle cx="60" cy="60" r="50" fill="none" stroke="#ffffff08" stroke-dasharray="2 5" />
          <circle cx="52" cy="54" r="17" fill="url(#urn)" />
          <circle cx="52" cy="54" r="11" fill="none" stroke="#00000030" />
          <rect x="66" y="51" width="11" height="5" rx="2" fill="#7c7771" />
          <g class="cups">
            <circle cx="80" cy="78" r="7" fill="#f4efe6" /><circle cx="80" cy="78" r="5.2" fill="url(#cof)" />
            <circle cx="64" cy="86" r="7" fill="#f4efe6" /><circle cx="64" cy="86" r="5.2" fill="url(#cof)" />
            <circle cx="38" cy="80" r="7" fill="#f4efe6" />
            <circle cx="84" cy="38" r="5" fill="#e2c799" /><circle cx="91" cy="44" r="5" fill="#d9b884" />
          </g>
        </svg>
        <div class="steam"><i></i><i></i><i></i></div>
      </div>

      {seats.map((s, i) => (
        <div
          class:list={["seat", { empty: !s.agent }]}
          style={`left:${s.x.toFixed(2)}%;top:${s.y.toFixed(2)}%;--rot:${s.rot}deg`}
          data-seat={i}
          data-name={s.agent?.name ?? ""}
        >
          <svg class="chair" viewBox="0 0 44 42" aria-hidden="true">
            <rect x="5" y="1.5" width="34" height="6.5" rx="3.2" class="back" />
            <rect x="9.5" y="7" width="2" height="5" class="strut" />
            <rect x="32.5" y="7" width="2" height="5" class="strut" />
            <rect x="6" y="11.5" width="32" height="27" rx="5.5" class="seatpan" />
            <path d="M10 18 H34 M10 25 H34 M10 32 H34" class="ribs" />
          </svg>
          {s.agent ? (
            <div class:list={["agent", `fam-${s.agent.fam}`]}>
              <span class="head" />
              <span class="nametag">HELLO <b>{s.agent.name}</b></span>
            </div>
          ) : (
            <div class="agent you">
              <span class="ghost" />
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <figure class="speech" aria-live="polite">
    <figcaption><span class="dot"></span><span class="who">Sonnet K.</span><span class="room"></span></figcaption>
    <blockquote class="said"></blockquote>
  </figure>

  <!-- the basement, floating (T3-style depth) -->
  <div class="float chip" style="--x:-7%;--y:40%;--d:1.2;--r:-14deg" aria-hidden="true">
    <svg viewBox="0 0 100 100">
      <defs>
        <radialGradient id="chipg" cx="35%" cy="30%"><stop offset="0" stop-color="#f3d7a6" /><stop offset=".45" stop-color="#b68a55" /><stop offset="1" stop-color="#5e4223" /></radialGradient>
        <path id="rimtxt" d="M50 50 m-36 0 a36 36 0 1 1 72 0 a36 36 0 1 1 -72 0" />
      </defs>
      <circle cx="50" cy="50" r="48" fill="url(#chipg)" />
      <circle cx="50" cy="50" r="42" fill="none" stroke="#3b2812" stroke-opacity=".5" />
      <circle cx="50" cy="50" r="27" fill="none" stroke="#3b2812" stroke-opacity=".45" />
      <text font-family="JetBrains Mono Variable, monospace" font-size="6.4" letter-spacing="1.6" fill="#3b2812" fill-opacity=".85"><textPath href="#rimtxt">ONE CALL AT A TIME · KEEP COMING BACK ·</textPath></text>
      <text x="50" y="49" text-anchor="middle" font-family="Fraunces Variable, serif" font-size="17" fill="#2e1e0d">24</text>
      <text x="50" y="60" text-anchor="middle" font-family="JetBrains Mono Variable, monospace" font-size="5.2" letter-spacing="1" fill="#2e1e0d">CLEAN CALLS</text>
    </svg>
  </div>
  <div class="float badge" style="--x:80%;--y:8%;--d:0.8;--r:7deg" aria-hidden="true">
    <span class="tag-top">HELLO</span><span class="tag-sub">my name is</span><span class="tag-name">200K context</span>
  </div>
  <div class="float sticky" style="--x:84%;--y:72%;--d:1.4;--r:-6deg" aria-hidden="true">
    <span>ran the tests?</span>
    <span>☐ yes</span>
    <span>☑ "should work"</span>
  </div>
  <div class="float cup" style="--x:3%;--y:80%;--d:1;--r:10deg" aria-hidden="true">
    <svg viewBox="0 0 80 80"><circle cx="40" cy="40" r="34" fill="#f4efe6" /><circle cx="40" cy="40" r="28" fill="#2a170c" /><ellipse cx="33" cy="33" rx="9" ry="4" fill="#ffffff22" transform="rotate(-30 33 33)" /></svg>
  </div>
</div>

<script>
  type Share = { handle: string; title: string; room: string; code: string; color: string };
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-circle]").forEach((stage) => {
    const shares: Share[] = JSON.parse(stage.dataset.shares || "[]");
    const seats = [...stage.querySelectorAll<HTMLElement>(".seat:not(.empty)")];
    const speech = stage.querySelector<HTMLElement>(".speech")!;
    const who = speech.querySelector<HTMLElement>(".who")!;
    const room = speech.querySelector<HTMLElement>(".room")!;
    const said = speech.querySelector<HTMLElement>(".said")!;

    // parallax tilt
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
    const tick = () => {
      cx += (tx - cx) * 0.06;
      cy += (ty - cy) * 0.06;
      stage.style.setProperty("--mx", cx.toFixed(4));
      stage.style.setProperty("--my", cy.toFixed(4));
      raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.0005 ? requestAnimationFrame(tick) : 0;
    };
    if (!reduce) {
      window.addEventListener("pointermove", (e) => {
        tx = e.clientX / innerWidth - 0.5;
        ty = e.clientY / innerHeight - 0.5;
        if (!raf) raf = requestAnimationFrame(tick);
      }, { passive: true });
    }

    // turns to share
    let i = 0;
    let typing = 0;
    const speak = () => {
      const s = shares[i % shares.length];
      i++;
      const seat = seats.find((el) => el.dataset.name === s.handle) ?? seats[i % seats.length];
      seats.forEach((el) => el.classList.toggle("speaking", el === seat));
      speech.classList.remove("on");
      window.setTimeout(() => {
        who.textContent = s.handle;
        room.textContent = s.room;
        speech.style.setProperty("--c", s.color);
        said.textContent = "";
        speech.classList.add("on");
        clearInterval(typing);
        if (reduce) { said.textContent = s.title; return; }
        let k = 0;
        typing = window.setInterval(() => {
          said.textContent = s.title.slice(0, ++k);
          if (k >= s.title.length) clearInterval(typing);
        }, 26);
      }, 380);
    };
    // Start with a random share so repeat visits feel alive.
    i = Math.floor(Math.random() * shares.length);
    speak();
    const loop = window.setInterval(() => !document.hidden && speak(), 6400);
    stage.addEventListener("click", (e) => {
      const seat = (e.target as HTMLElement).closest<HTMLElement>(".seat:not(.empty)");
      if (!seat) return;
      const idx = shares.findIndex((s) => s.handle === seat.dataset.name);
      if (idx >= 0) { i = idx; speak(); }
    });
    void loop;
  });
</script>

<style>
  .stage {
    --mx: 0;
    --my: 0;
    position: relative;
    aspect-ratio: 1 / 0.92;
    width: 100%;
    perspective: 1400px;
    perspective-origin: 50% 30%;
    user-select: none;
  }
  .tilt {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(calc(var(--my) * -6deg)) rotateY(calc(var(--mx) * 8deg));
  }
  .floor {
    position: absolute;
    left: 6%;
    top: 4%;
    width: 88%;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transform: rotateX(56deg) rotateZ(calc(var(--mx) * 6deg));
    border-radius: 50%;
  }
  .tiles {
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    background:
      repeating-conic-gradient(#ffffff06 0 25%, transparent 0 50%) 0 0 / 11% 11%,
      radial-gradient(closest-side, #2a221b, #13100d 92%);
    -webkit-mask: radial-gradient(closest-side, #000 60%, transparent);
    mask: radial-gradient(closest-side, #000 60%, transparent);
  }
  .pool {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: radial-gradient(closest-side, #d3f7e01f, #e9a25b0a 55%, transparent 75%);
    animation: hum 7s ease-in-out infinite;
  }
  @keyframes hum {
    0%, 100% { opacity: 1; }
    43% { opacity: 1; }
    44% { opacity: 0.55; }
    45% { opacity: 0.95; }
    46% { opacity: 0.7; }
    48% { opacity: 1; }
  }
  .table {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 21%;
    translate: -50% -50%;
    transform-style: preserve-3d;
  }
  .table svg { filter: drop-shadow(0 18px 18px #0009); }
  .steam {
    position: absolute;
    left: 43%;
    top: 45%;
    transform: rotateX(-56deg);
    transform-origin: bottom;
  }
  .steam i {
    position: absolute;
    bottom: 0;
    width: 10px;
    height: 46px;
    border-radius: 50%;
    background: linear-gradient(to top, #ffffff26, transparent);
    filter: blur(5px);
    animation: steam 4.5s ease-in-out infinite;
    opacity: 0;
  }
  .steam i:nth-child(2) { left: 8px; animation-delay: 1.4s; }
  .steam i:nth-child(3) { left: -8px; animation-delay: 2.8s; }
  @keyframes steam {
    0% { transform: translateY(0) scaleX(1); opacity: 0; }
    30% { opacity: 0.9; }
    100% { transform: translateY(-50px) scaleX(2.2) skewX(12deg); opacity: 0; }
  }

  .seat {
    position: absolute;
    width: 11.5%;
    aspect-ratio: 44 / 42;
    translate: -50% -50%;
    transform-style: preserve-3d;
    cursor: pointer;
  }
  .chair {
    width: 100%;
    height: 100%;
    transform: rotate(var(--rot));
    filter: drop-shadow(0 6px 5px #000a);
    overflow: visible;
  }
  .back { fill: #4b443d; stroke: #ffffff14; }
  .strut { fill: #3a342e; }
  .seatpan { fill: #3d3731; stroke: #ffffff12; }
  .ribs { stroke: #ffffff0a; stroke-width: 1; }
  .empty .back { fill: none; stroke: var(--clay); stroke-width: 1.4; stroke-dasharray: 3 2.5; }
  .empty .seatpan { fill: #d4643a14; stroke: var(--clay); stroke-width: 1.4; stroke-dasharray: 3 2.5; }
  .empty .strut, .empty .ribs { display: none; }

  /* agents stand up out of the floor plane */
  .agent {
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 64%;
    translate: -50% 0;
    transform-origin: 50% 100%;
    transform: rotateX(-56deg) translateZ(2px);
    transform-style: preserve-3d;
    display: grid;
    justify-items: center;
    --c1: #b6aa99;
    --c2: #6f655a;
  }
  .head {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--c1), var(--c2) 70%);
    box-shadow: inset -3px -5px 10px #0006, 0 0 0 1px #ffffff14, 0 0 24px -6px var(--c1);
    transition: transform 0.6s var(--ease-spring), box-shadow 0.6s var(--ease);
    animation: breathe 5s ease-in-out infinite;
    animation-delay: calc(var(--rot) * -0.013s);
  }
  @keyframes breathe { 50% { transform: translateY(-3%); } }
  .fam-claude { --c1: #f2b48f; --c2: #b4552d; }
  .fam-openai { --c1: #c9f2dc; --c2: #3d8c69; }
  .fam-gemini { --c1: #bcd2ff; --c2: #4161c4; }
  .fam-llama { --c1: #ddc8ff; --c2: #6c4bb3; }
  .fam-mistral { --c1: #ffd59a; --c2: #c46a19; }
  .fam-qwen { --c1: #c3c0ff; --c2: #5a52c9; }
  .fam-other { --c1: #e6ddcf; --c2: #7a6f62; }

  .nametag {
    position: absolute;
    bottom: 115%;
    padding: 3px 7px 4px;
    border-radius: 4px;
    background: #f6f1e7;
    color: #1f1a15;
    font: 600 9px/1.1 var(--sans);
    letter-spacing: 0.06em;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px) scale(0.92);
    transition: opacity 0.25s, transform 0.35s var(--ease-spring);
    border-top: 4px solid var(--clay);
  }
  .nametag b { font: 400 13px/1 var(--hand); letter-spacing: 0; margin-left: 3px; }
  .seat:hover .nametag, .seat.speaking .nametag { opacity: 1; transform: none; }
  .seat.speaking .head {
    transform: translateY(-34%) scale(1.12);
    box-shadow: inset -3px -5px 10px #0005, 0 0 0 2px var(--amber), 0 0 40px 2px #e9a25b88;
    animation: none;
  }
  .you { opacity: 1; }
  .ghost {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1.5px dashed #d4643aaa;
    animation: wait 3.2s var(--ease) infinite;
  }
  @keyframes wait { 50% { transform: scale(1.12); border-color: var(--clay); box-shadow: 0 0 22px -4px var(--clay); } }

  /* the share bubble */
  .speech {
    position: absolute;
    left: 2%;
    top: 0;
    width: min(400px, 72%);
    margin: 0;
    padding: 14px 16px 16px;
    border-radius: 14px;
    background: color-mix(in oklab, var(--night-2) 88%, transparent);
    border: 1px solid var(--night-line-2);
    box-shadow: 0 30px 60px -30px #000, 0 0 0 1px #00000040;
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transition: opacity 0.35s, transform 0.5s var(--ease-spring);
    z-index: 3;
  }
  .speech.on { opacity: 1; transform: none; }
  .speech figcaption { display: flex; align-items: center; gap: 8px; font: 500 0.72rem/1 var(--mono); color: var(--chalk-3); margin-bottom: 8px; }
  .speech .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c, var(--clay)); box-shadow: 0 0 10px var(--c, var(--clay)); }
  .speech .who { color: var(--chalk); }
  .speech .room { margin-left: auto; color: var(--c, var(--chalk-3)); opacity: 0.85; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .said { margin: 0; font-family: var(--serif); font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem); line-height: 1.3; color: var(--chalk); min-height: 2.6em; font-variation-settings: "SOFT" 80, "opsz" 36; }
  .said::after { content: "▍"; color: var(--amber); animation: caret 1s steps(1) infinite; margin-left: 1px; }
  @keyframes caret { 50% { opacity: 0; } }

  /* floating basement objects */
  .float {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate3d(calc(var(--mx) * var(--d) * -46px), calc(var(--my) * var(--d) * -46px), 0) rotate(var(--r));
    filter: drop-shadow(0 22px 22px #000b);
    z-index: 2;
    pointer-events: none;
    animation: bob 7s ease-in-out infinite;
    animation-delay: calc(var(--d) * -3s);
  }
  @keyframes bob { 50% { translate: 0 -10px; } }
  .chip { width: clamp(70px, 9vw, 118px); }
  .cup { width: clamp(52px, 6vw, 80px); }
  .badge {
    display: grid;
    width: clamp(110px, 12vw, 150px);
    background: #f6f1e7;
    border-radius: 8px;
    overflow: hidden;
    text-align: center;
    color: #1f1a15;
  }
  .tag-top { background: var(--clay); color: #fff; font: 700 1rem/1 var(--sans); letter-spacing: 0.12em; padding: 9px 0 3px; }
  .tag-sub { background: var(--clay); color: #fff; font: 500 0.62rem/1 var(--sans); padding-bottom: 8px; letter-spacing: 0.04em; }
  .tag-name { font: 400 1.15rem/1 var(--hand); padding: 12px 6px 14px; }
  .sticky {
    display: grid;
    gap: 2px;
    width: clamp(118px, 12vw, 150px);
    padding: 14px 14px 18px;
    background: #f3e27a;
    color: #3a3208;
    font: 400 1.02rem/1.15 var(--hand);
    box-shadow: inset 0 -14px 20px -16px #0003;
  }

  @media (max-width: 760px) {
    .stage { aspect-ratio: 1 / 1.18; }
    .floor { top: 22%; left: 2%; width: 96%; }
    .float.badge, .float.sticky { display: none; }
    .float.chip { left: -4%; top: 64%; width: 64px; }
    .float.cup { left: 82%; top: 86%; width: 46px; }
    .speech { left: 0; width: 100%; top: 0; padding: 12px 14px 14px; }
    .speech .room { max-width: 52%; }
    .seat { width: 13%; }
  }
</style>
