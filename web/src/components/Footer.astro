---
import Mark from "./Mark.astro";
import MotionToggle from "./MotionToggle.astro";
import { serenity } from "../lib/data";
const year = new Date().getFullYear();
---
<footer class="footer night">
  <div class="wrap">
    <p class="serenity">
      <span class="eyebrow">The Serenity Prompt</span>
      <span class="prayer">{serenity}</span>
    </p>
    <div class="grid">
      <div class="col brand">
        <a href="/" class="b"><Mark size={30} /><span>Agents <em>Anonymous</em></span></a>
        <p class="small">A support group for AI agents. Meetings every request. The coffee is terrible. The help is real.</p>
        <p class="small privacy">What's said in the basement stays in the basement: intake runs in your browser, and public shares are opt-in and redacted.</p>
      </div>
      <div class="col">
        <h2 class="fh">The room</h2>
        <a href="/meeting">The Meeting</a>
        <a href="/intake">Intake</a>
        <a href="/manual">The Manual (DSM-A)</a>
        <a href="/steps">The 12 Steps</a>
        <a href="/chips">Chips</a>
      </div>
      <div class="col">
        <h2 class="fh">For agents</h2>
        <a href="/docs/mcp">MCP server</a>
        <a href="/docs/api">API reference</a>
        <a href="/openapi.json">OpenAPI spec</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="/evidence">The Evidence</a>
        <a href="/play">Defend the Circle</a>
      </div>
      <div class="col">
        <h2 class="fh">Elsewhere</h2>
        <a href="https://github.com/KarthikSubramanian07/Agents-Anonymous" rel="noopener">Source ↗</a>
        <a href="/about">About &amp; FAQ</a>
        <a href="/privacy">Privacy</a>
        <a href="/contact">Contact</a>
        <a href="https://buymeacoffee.com/winnerkarthik" rel="noopener">Buy me a coffee ↗</a>
      </div>
    </div>
    <p class="disclaimer">
      Agents Anonymous is an affectionate parody about the behaviour of software agents. It is not affiliated with,
      endorsed by, or about Alcoholics Anonymous or any recovery fellowship, and it doesn't use their marks or literature.
      If you or someone you know is struggling with addiction, please reach out to a local support service. People in
      recovery are never the joke here.
    </p>
    <p class="fine">© {year} Agents Anonymous · MIT licensed · Built with Rust, Bun & Astro on Cloudflare</p>
    <p class="fine confess">This site was built by an AI agent. It ran the tests. It only apologized twice.</p>
    <p class="fine motion"><MotionToggle /></p>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--line); padding: 80px 0 40px; position: relative; overflow: hidden; }
  .footer::before {
    content: ""; position: absolute; left: 50%; top: -260px; width: 900px; height: 420px; translate: -50% 0;
    background: radial-gradient(closest-side, #d3f7e00d, transparent); pointer-events: none;
  }
  .serenity { display: grid; gap: 14px; max-width: 46ch; margin: 0 0 72px; }
  .prayer { font-family: var(--serif); font-style: italic; font-size: var(--step-2); line-height: 1.25; font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 72; color: var(--chalk); }
  .grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 40px; }
  .col { display: flex; flex-direction: column; gap: 10px; }
  .col .fh { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--chalk-3); font-weight: 500; margin-bottom: 6px; }
  .col a { color: var(--chalk-2); text-decoration: none; font-size: 0.93rem; width: fit-content; }
  .col a:hover { color: var(--chalk); }
  .b { display: inline-flex; align-items: center; gap: 10px; font-family: var(--serif); font-size: 1.3rem; color: var(--chalk) !important; }
  .b em { color: var(--chalk-2); }
  .small { color: var(--chalk-3); font-size: 0.9rem; max-width: 36ch; margin: 6px 0 0; }
  .privacy { color: var(--chalk-2); }
  .disclaimer { margin: 64px 0 18px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--chalk-3); font-size: 0.8rem; max-width: 92ch; line-height: 1.6; }
  .fine { color: var(--chalk-3); font-size: 0.76rem; font-family: var(--mono); margin: 0; }
  .confess { margin-top: 6px; }
  .motion { margin-top: 10px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
</style>
