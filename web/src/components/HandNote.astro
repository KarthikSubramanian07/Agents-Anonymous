---
/** A handwritten margin note with a drawn arrow — the human in the room. */
interface Props { arrow?: "left" | "right" | "down" | "up" | "none"; rotate?: number; class?: string }
const { arrow = "down", rotate = -4, class: cls = "" } = Astro.props;
const paths: Record<string, string> = {
  down: "M10 4 C 30 10, 44 26, 38 52 M28 44 L38 53 L46 42",
  left: "M74 10 C 54 4, 26 10, 8 30 M8 18 L7 31 L20 32",
  right: "M6 10 C 26 4, 54 10, 72 30 M60 32 L73 31 L72 18",
  up: "M40 56 C 30 40, 30 24, 40 6 M30 14 L40 5 L48 15",
};
---
<span class:list={["handnote", `arrow-${arrow}`, cls]} style={`--r:${rotate}deg`}>
  <span class="hand-text"><slot /></span>
  {arrow !== "none" && (
    <svg class="hand-arrow" viewBox="0 0 80 60" fill="none" aria-hidden="true">
      <path d={paths[arrow]} stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
    </svg>
  )}
</span>
<style>
  .handnote {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    font-family: var(--hand);
    color: var(--accent, var(--clay));
    font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.45rem);
    line-height: 1.05;
    transform: rotate(var(--r));
    pointer-events: none;
  }
  .arrow-left, .arrow-right { flex-direction: row; align-items: center; gap: 0.2em; }
  .arrow-left { flex-direction: row-reverse; }
  .arrow-up { flex-direction: column-reverse; }
  .hand-arrow { width: 3.4em; height: auto; }
  .hand-arrow path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.1s 0.6s var(--ease) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
</style>
